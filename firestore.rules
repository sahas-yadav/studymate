rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isBoundedNumberList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is number);
    }

    // Entity validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'visibility', 'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'fullName', 'avatarUrl', 'university', 'course', 'year', 'bio',
          'subjects', 'strengths', 'weaknesses', 'availabilitySlots',
          'studyStyle', 'studyMode', 'goals', 'visibility', 'onboardingCompleted',
          'isOnline', 'lastSeen', 'streakDays', 'totalHours', 'sessionsCompleted',
          'ratingAvg', 'reviewCount', 'weeklyHours', 'isSample', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000))
        && (!('university' in data) || (data.university is string && data.university.size() <= 140))
        && (!('course' in data) || (data.course is string && data.course.size() <= 140))
        && (!('year' in data) || (data.year is string && data.year.size() <= 40))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 600))
        && (!('subjects' in data) || isBoundedStringList(data.subjects, 20))
        && (!('strengths' in data) || isBoundedStringList(data.strengths, 20))
        && (!('weaknesses' in data) || isBoundedStringList(data.weaknesses, 20))
        && (!('availabilitySlots' in data) || isBoundedStringList(data.availabilitySlots, 42))
        && (!('studyStyle' in data) || data.studyStyle in ['quiet', 'collaborative', 'discussion', 'pomodoro'])
        && (!('studyMode' in data) || data.studyMode in ['online', 'in-person', 'hybrid'])
        && (!('goals' in data) || isBoundedStringList(data.goals, 12))
        && data.visibility in ['public', 'connections', 'private']
        && data.onboardingCompleted is bool
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000))
        && (!('totalHours' in data) || (data.totalHours is number && data.totalHours >= 0 && data.totalHours <= 100000))
        && (!('sessionsCompleted' in data) || (data.sessionsCompleted is number && data.sessionsCompleted >= 0 && data.sessionsCompleted <= 100000))
        && (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 10000))
        && (!('weeklyHours' in data) || isBoundedNumberList(data.weeklyHours, 7))
        && (!('isSample' in data) || data.isSample is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateUserInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'notificationPrefs', 'privacyPrefs', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && (!('notificationPrefs' in data) || data.notificationPrefs is map)
        && (!('privacyPrefs' in data) || data.privacyPrefs is map)
        && data.updatedAt is timestamp;
    }

    function isValidConnection(data) {
      return data.keys().hasAll(['fromUserId', 'toUserId', 'participantIds', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fromUserId', 'toUserId', 'participantIds', 'status', 'message', 'createdAt', 'updatedAt'])
        && data.fromUserId is string && data.fromUserId.size() <= 128
        && data.toUserId is string && data.toUserId.size() <= 128
        && data.fromUserId != data.toUserId
        && data.participantIds is list && data.participantIds.size() == 2
        && data.fromUserId in data.participantIds
        && data.toUserId in data.participantIds
        && data.status in ['pending', 'accepted', 'declined']
        && (!('message' in data) || (data.message is string && data.message.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['type', 'participantIds', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'type', 'name', 'subject', 'description', 'participantIds', 'createdBy',
          'lastMessageText', 'lastMessageAt', 'lastMessageSenderId', 'unreadCounts',
          'typingUsers', 'isPublicGroup', 'createdAt', 'updatedAt'
        ])
        && data.type in ['direct', 'group']
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 120))
        && (!('description' in data) || (data.description is string && data.description.size() <= 400))
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 30
        && data.createdBy is string && data.createdBy.size() <= 128
        && (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500))
        && (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128))
        && (!('unreadCounts' in data) || data.unreadCounts is map)
        && (!('typingUsers' in data) || data.typingUsers is map)
        && (!('isPublicGroup' in data) || data.isPublicGroup is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'readBy', 'createdAt'])
        && data.keys().hasOnly([
          'senderId', 'senderName', 'text', 'attachmentUrl', 'attachmentName',
          'attachmentType', 'sessionProposalId', 'readBy', 'createdAt'
        ])
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.text is string && data.text.size() <= 2000
        && (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 600000))
        && (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200))
        && (!('attachmentType' in data) || (data.attachmentType is string && data.attachmentType.size() <= 100))
        && (!('sessionProposalId' in data) || (data.sessionProposalId is string && data.sessionProposalId.size() <= 128))
        && isBoundedStringList(data.readBy, 30)
        && data.createdAt is timestamp;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['title', 'subject', 'creatorId', 'participantIds', 'startTime', 'durationMinutes', 'mode', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'title', 'subject', 'creatorId', 'participantIds', 'participantResponses',
          'startTime', 'durationMinutes', 'mode', 'locationOrLink', 'notes',
          'status', 'conversationId', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.creatorId is string && data.creatorId.size() <= 128
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 30
        && (!('participantResponses' in data) || data.participantResponses is map)
        && data.startTime is timestamp
        && data.durationMinutes is number && data.durationMinutes >= 15 && data.durationMinutes <= 480
        && data.mode in ['online', 'in-person']
        && (!('locationOrLink' in data) || (data.locationOrLink is string && data.locationOrLink.size() <= 300))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.status in ['pending', 'accepted', 'declined', 'cancelled', 'completed']
        && (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'body', 'read', 'createdAt'])
        && data.keys().hasOnly(['userId', 'type', 'title', 'body', 'link', 'relatedId', 'read', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.type in ['connection_request', 'connection_accepted', 'session_invite', 'session_update', 'session_reminder', 'message', 'review']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 400
        && (!('link' in data) || (data.link is string && data.link.size() <= 200))
        && (!('relatedId' in data) || (data.relatedId is string && data.relatedId.size() <= 128))
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['targetUserId', 'authorId', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['targetUserId', 'authorId', 'authorName', 'authorAvatar', 'rating', 'comment', 'subject', 'createdAt'])
        && data.targetUserId is string && data.targetUserId.size() <= 128
        && data.authorId is string && data.authorId.size() <= 128
        && data.targetUserId != data.authorId
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 200000))
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 600
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 120))
        && data.createdAt is timestamp;
    }

    // 1. Users (Public matching profiles)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        userId == request.auth.uid || existing().visibility in ['public', 'connections']
      );
      allow list: if isSignedIn() && (
        existing().visibility == 'public' || existing().uid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        (userId == request.auth.uid && incoming().uid == request.auth.uid) ||
        (userId.matches('^sample_[a-zA-Z0-9_]+$') && incoming().uid == userId && incoming().isSample == true)
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming())
        && userId == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private PII & account settings
      match /private/{docId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidPrivateUserInfo(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }

    // 2. Connections
    match /connections/{connectionId} {
      allow get: if isSignedIn() && isValidId(connectionId) && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow create: if isSignedIn() && isValidId(connectionId) && isValidConnection(incoming())
        && request.auth.uid in incoming().participantIds
        && (incoming().fromUserId == request.auth.uid || incoming().fromUserId.matches('^sample_[a-zA-Z0-9_]+$'));
      allow update: if isSignedIn() && isValidId(connectionId) && isValidConnection(incoming())
        && request.auth.uid in existing().participantIds
        && incoming().fromUserId == existing().fromUserId
        && incoming().toUserId == existing().toUserId
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(connectionId) && request.auth.uid in existing().participantIds;
    }

    // 3. Conversations & Messages
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (
        request.auth.uid in existing().participantIds || existing().isPublicGroup == true
      );
      allow list: if isSignedIn() && (
        request.auth.uid in existing().participantIds || existing().isPublicGroup == true
      );
      allow create: if isSignedIn() && isValidId(conversationId) && isValidConversation(incoming())
        && request.auth.uid in incoming().participantIds;
      allow update: if isSignedIn() && isValidId(conversationId) && isValidConversation(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (request.auth.uid in existing().participantIds && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'subject', 'description', 'participantIds', 'lastMessageText',
            'lastMessageAt', 'lastMessageSenderId', 'unreadCounts', 'typingUsers', 'isPublicGroup', 'updatedAt'
          ])) ||
          (existing().isPublicGroup == true && incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'updatedAt'])
            && request.auth.uid in incoming().participantIds)
        );
      allow delete: if isSignedIn() && isValidId(conversationId) && existing().createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(conversationId)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() && isValidId(conversationId) && isValidId(messageId)
          && isValidMessage(incoming())
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && (incoming().senderId == request.auth.uid || incoming().senderId.matches('^sample_[a-zA-Z0-9_]+$'));
        allow update: if isSignedIn() && isValidId(conversationId) && isValidId(messageId)
          && isValidMessage(incoming())
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && incoming().diff(existing()).affectedKeys().hasOnly(['readBy']);
        allow delete: if isSignedIn() && isValidId(conversationId) && isValidId(messageId)
          && existing().senderId == request.auth.uid;
      }
    }

    // 4. Study Sessions
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming())
        && request.auth.uid in incoming().participantIds;
      allow update: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming())
        && request.auth.uid in existing().participantIds
        && incoming().creatorId == existing().creatorId
        && incoming().createdAt == existing().createdAt
        && existing().status != 'cancelled'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subject', 'participantIds', 'participantResponses', 'startTime',
          'durationMinutes', 'mode', 'locationOrLink', 'notes', 'status', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(sessionId) && existing().creatorId == request.auth.uid;
    }

    // 5. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid;
    }

    // 6. Partner Reviews
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn() && existing().targetUserId is string;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming())
        && (incoming().authorId == request.auth.uid || incoming().authorId.matches('^sample_[a-zA-Z0-9_]+$'));
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(reviewId) && existing().authorId == request.auth.uid;
    }
  }
}
